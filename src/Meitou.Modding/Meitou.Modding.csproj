<Project Sdk="Microsoft.NET.Sdk">
  <!-- The CPU code-mod contract and loader share their feature sources with the game. -->
  <ItemGroup>
    <ProjectReference Include="../Meitou.Simulation/Meitou.Simulation.csproj" />
    <PackageReference Include="Lib.Harmony" Version="3.0.0-rc.5" />
    <InternalsVisibleTo Include="Meitou.Tests" />
    <InternalsVisibleTo Include="MeitouClient" />
    <Compile Include="../Meitou.Game/Mods/*.cs" Exclude="../Meitou.Game/Mods/GameMods.cs;../Meitou.Game/Mods/PlayerUiExtension.cs" Link="Mods/%(Filename)%(Extension)" />
    <Compile Include="../Meitou.Game/Ui/UiHost.cs;../Meitou.Game/Ui/UiNode.cs" Link="Ui/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>