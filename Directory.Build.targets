<Project>

  <PropertyGroup>
    <MeitouQuicRuntimePath Condition="'$(MeitouQuicRuntimePath)' == ''">$(MSBuildThisFileDirectory)artifacts/network-vnext-transport/win-x64</MeitouQuicRuntimePath>
  </PropertyGroup>
  <ItemGroup Condition="('$(MSBuildProjectName)' == 'Meitou.Game' or '$(MSBuildProjectName)' == 'Meitou.Server') and ('$(RuntimeIdentifier)' == 'win-x64' or ('$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Windows'))))">
    <None Include="$(MeitouQuicRuntimePath)/*.dll;$(MeitouQuicRuntimePath)/manifest.json;$(MeitouQuicRuntimePath)/LICENSE*;$(MeitouQuicRuntimePath)/THIRD-PARTY-NOTICES*"
          Link="native/quic/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="RequireQuicRuntimeForWindowsPublish" BeforeTargets="PrepareForPublish"
          Condition="('$(MSBuildProjectName)' == 'Meitou.Game' or '$(MSBuildProjectName)' == 'Meitou.Server') and '$(RuntimeIdentifier)' == 'win-x64'">
    <Error Condition="!Exists('$(MeitouQuicRuntimePath)/Meitou.QuicTransport.dll') or !Exists('$(MeitouQuicRuntimePath)/msquic.dll') or !Exists('$(MeitouQuicRuntimePath)/manifest.json')"
           Text="Build tools/Meitou.QuicTransport/build.ps1 before publishing the paired protocol 21 runtime." />
  </Target>

  <!-- Local vendor binaries stay outside source control; both executable projects need the same runtime. Each one present is copied: Streamline
       for DLSS, amd_fidelityfx_vk.dll for FSR (the release zips fetch them in tools/scripts/package-release.ps1). -->
  <PropertyGroup>
    <StreamlineRuntimePath Condition="'$(StreamlineRuntimePath)' == ''">$(MEITOU_DLSS_PATH)</StreamlineRuntimePath>
    <StreamlineRuntimePath Condition="'$(StreamlineRuntimePath)' == ''">$(MEITOU_STREAMLINE_PATH)</StreamlineRuntimePath>
    <StreamlineRuntimePath Condition="'$(StreamlineRuntimePath)' == ''">$(MSBuildThisFileDirectory)dlss-runtime</StreamlineRuntimePath>
  </PropertyGroup>

  <ItemGroup Condition="('$(MSBuildProjectName)' == 'Meitou.Game' or '$(MSBuildProjectName)' == 'Meitou.ModelViewer') and ('$(RuntimeIdentifier)' == '' or $(RuntimeIdentifier.StartsWith('win-')))">
    <!-- Wildcards, so only the files present are listed. -->
    <None Include="$(StreamlineRuntimePath)/sl.*.dll;$(StreamlineRuntimePath)/nvngx_dlss*.dll;$(StreamlineRuntimePath)/meitou_ngx*.dll;$(StreamlineRuntimePath)/NvLowLatencyVk*.dll;$(StreamlineRuntimePath)/amd_fidelityfx_vk*.dll"
          Link="Native/%(Filename)%(Extension)" TargetPath="%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Linux: the DLSS model and NGX's client library (libmeitou_ngx.so, tools/scripts/build-ngx-shim.sh) for Ngx.cs, the model in any version,
       and our Linux build of the FidelityFX library (libamd_fidelityfx_vk.so, with AMD's licence text) for FSR and frame generation. -->
  <ItemGroup Condition="('$(MSBuildProjectName)' == 'Meitou.Game' or '$(MSBuildProjectName)' == 'Meitou.ModelViewer') and Exists('$(StreamlineRuntimePath)') and ('$(RuntimeIdentifier)' == '' or $(RuntimeIdentifier.StartsWith('linux-')))">
    <None Include="$(StreamlineRuntimePath)/libnvidia-ngx-dlss.so.*;$(StreamlineRuntimePath)/libmeitou_ngx*.so;$(StreamlineRuntimePath)/libamd_fidelityfx_vk*.so;$(StreamlineRuntimePath)/LICENSE-FidelityFX*.txt" Link="Native/%(Filename)%(Extension)"
         TargetPath="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <!-- Ship the matching vendor notices with client/viewer binaries, including locally built runtimes' root licences. -->
  <ItemGroup Condition="('$(MSBuildProjectName)' == 'Meitou.Game' or '$(MSBuildProjectName)' == 'Meitou.ModelViewer') and Exists('$(StreamlineRuntimePath)')">
    <None Include="$(StreamlineRuntimePath)/licenses/**/*"
          Link="licenses/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(StreamlineRuntimePath)/LICENSE*"
          Link="licenses/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />

  </ItemGroup>

  <Target Name="RequireCodeModJitPublish" BeforeTargets="PrepareForPublish"
          Condition="'$(MSBuildProjectName)' == 'Meitou.Game' or '$(MSBuildProjectName)' == 'Meitou.Server' or '$(MSBuildProjectName)' == 'Meitou.Tools'">
    <Error Condition="'$(PublishTrimmed)' == 'true' or '$(PublishAot)' == 'true' or '$(PublishSingleFile)' == 'true'"
           Text="Code mods require an untrimmed JIT publish with separate managed assemblies." />
  </Target>
</Project>